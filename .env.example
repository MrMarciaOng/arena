# The database. Two kinds:
#   postgres://...      Supabase (or any Postgres). On Vercel use Supabase's transaction pooler
#                       (Connect > Transaction pooler, port 6543); prepared statements are then off.
#   pglite:<directory>  PGlite, an embedded Postgres in a local directory (or pglite:memory).
#                       For local development; created and migrated on first use.
# Left empty, it is pglite:./data/pglite. Production refuses PGlite unless ARENA_ALLOW_EMBEDDED_DB=1,
# and Vercel always refuses it (its filesystem doesn't last).
DATABASE_URL=

# Vercel Cron sends this as a bearer token to /api/cron/maintenance (the daily cleanup).
# At least 16 characters. Without it the cleanup endpoint refuses every call.
CRON_SECRET=

# Bearer token for the admin API (create, rename and delete arenas; manage API keys). At least 24 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ARENA_ADMIN_TOKEN=

# Owner login uses password mode by default. Set supabase to use Supabase Auth.
ARENA_AUTH_PROVIDER=password
# Required in supabase mode. Use the Supabase project's URL and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Password for the web UI in password mode. At least 8 characters.
ARENA_OWNER_PASSWORD=
# Signs the cookie in password mode. At least 32 characters. Also the fallback encryption key.
ARENA_SESSION_SECRET=

# Encrypts stored API keys so the owner can copy them again from Settings. At least 32 characters.
# Optional: ARENA_SESSION_SECRET is used when it's empty. Changing it means existing keys still
# work but can't be copied again (create new ones).
ARENA_ENCRYPTION_KEY=

# In password mode, 1 lets anyone who can reach the app read legacy dashboards and answers.
# Every change still needs the owner session or the admin token.
ARENA_ALLOW_ANONYMOUS_READ=0

# 1 lets the login cookie work over plain HTTP in production (for a LAN or tailnet without TLS).
# Leave at 0 when Arena is served over HTTPS.
ARENA_INSECURE_COOKIE=0

# 1 only if a proxy in front of Arena overwrites X-Forwarded-For (Vercel does). Then failed logins
# are throttled per client address; otherwise all clients share one throttle.
ARENA_TRUST_PROXY=0
